            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"User12345!\",\n  \"first_name\": \"Aziz\",\n  \"last_name\": \"Rahimov\",\n  \"phone_number\": \"+998901234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Foydalanuvchi muvaffaqiyatli yaratildi', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.email).to.eql('testuser@example.com');",
                  "    pm.expect(jsonData.role).to.eql('user');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
